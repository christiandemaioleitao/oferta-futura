# Copie para .env na raiz do repo e preencha. O .env é ignorado pelo git.
# Os mesmos valores vão para os secrets do GitHub Actions.

# Postgres do Neon (dashboard + chat de IA). Na Vercel, a mesma string vai em DATABASE_URL.
NEON_DATABASE_URL=postgresql://usuario:senha@host.neon.tech/dbname?sslmode=require

# SQL Server do Portal Inteligência de Mercado
SQLSERVER_HOST=
SQLSERVER_DB=
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# Parâmetros do pipeline (opcionais — estes são os padrões)
# OF_LANCTO_INI=01/2026
# OF_LANCTO_FIM=12/2027
# DATA_FIM_PROJ=06/2027
# FATOR_AJUSTE=1.0
# OF_IGNORAR_QUEDA=1   # libera a guarda de sanidade quando a queda de base é real
